<http://example.org/article/Radiobiologic_risk_estimation_from_dental_radiology._Part_I._Absorbed_doses_to_critical_organs.> a ex:Article ;
    ex:access 2 ;
    schema1:about <http://example.org/mesh/Bone_Marrow_>,
        <http://example.org/mesh/Panoramic_>,
        <http://example.org/mesh/Structural_>,
        <http://example.org/mesh/_Cervical_Vertebrae_>,
