        <http://example.org/mesh/_Concanavalin_A_>,
        <http://example.org/mesh/_Cytokines_>,
        <http://example.org/mesh/_Dietary_Supplements_>,
        <http://example.org/mesh/_Disease_Models>,
        <http://example.org/mesh/_Eating_>,
        <http://example.org/mesh/_Female_>,
